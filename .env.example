# Next.js / Vercel. Copy to .env.local and fill locally. Never commit credentials.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# Gemini 1.5 Pro is retired. Select a currently supported Vertex model.
VERTEX_MODEL=gemini-2.5-pro
# JSON service account credential, or use service-account ADC locally.
GOOGLE_SERVICE_ACCOUNT_JSON=
# HTTPS origin of the private Cloud Run RAG service.
CLOUD_RUN_RAG_URL=
# At least 32 random characters. Generate with node:crypto randomBytes.
SESSION_SECRET=
